# Copy to .env and fill in locally. Never commit .env.
# Names only; no values are valid defaults.

# --- Paths (all local, all git-ignored) ---
LITBIORAG_DATA_DIR=            # root for corpus, indexes, metadata store
LITBIORAG_MODELS_DIR=          # local model cache (HF_HOME is also honoured)

# --- Model selection (overridden by configs/*.yaml; filled after benchmarking) ---
LITBIORAG_DENSE_ENCODER=
LITBIORAG_RERANKER=
LITBIORAG_GENERATOR=
LITBIORAG_VERIFIER=

# --- External services ---
NCBI_API_KEY=                  # E-utilities; raises rate limit from 3 to 10 req/s
NCBI_EMAIL=                    # required by NCBI usage policy
OPENAI_API_KEY=                # hosted generator (profile `hosted`) and offline LLM-as-judge
ANTHROPIC_API_KEY=             # alternative hosted generator; swap in configs/models.yaml
LITBIORAG_GENERATOR_API_KEY=   # any other /v1/chat/completions provider; name it in api_key_env

# --- Resource controls (defaults in configs/resources.yaml; env overrides) ---
LITBIORAG_RESOURCES_CONFIG=    # alternate resources.yaml (e.g. a 24 GB GPU host)
LITBIORAG_ENTITIES_CONFIG=     # alternate entities.yaml (extra confusable groups / synonyms)

# --- Service ---
LITBIORAG_API_HOST=0.0.0.0
LITBIORAG_API_PORT=8000
LITBIORAG_LOG_LEVEL=INFO
